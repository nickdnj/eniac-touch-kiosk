From 5623606231ccb3beae50068a052686f9bd666e48 Mon Sep 17 00:00:00 2001
From: Nick DeMarco <nickd@demarconet.com>
Date: Fri, 2 Oct 2026 08:13:16 -0400
Subject: [PATCH 1/3] mult: print the multiplier stage without padding

multstat() formats the stage as "%2d ", so a stage below 10 is sent
with a leading space ("m  0 ..."). vis/eniactk.go splits status
messages on single spaces, indexes an empty field and panics
("index out of range [1] with length 1" at eniactk.go:785) the first
time the multiplier runs. Print "%d " instead.
---
 src/mult.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/mult.go b/src/mult.go
index 4a05a6e..77baedb 100644
--- a/src/mult.go
+++ b/src/mult.go
@@ -63,7 +63,7 @@ var table1 [10][10]pulseset = [10][10]pulseset{{},
 }
 
 func multstat() string {
-	s := fmt.Sprintf("%2d ", stage)
+	s := fmt.Sprintf("%d ", stage)
 	for i, _ := range multff {
 		if multff[i] {
 			s += "1"
-- 
