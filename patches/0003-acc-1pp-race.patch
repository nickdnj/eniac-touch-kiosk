From e390f848a6f42742a0d26a32a2bd8c793deaefd0 Mon Sep 17 00:00:00 2001
From: Nick DeMarco <nickd@demarconet.com>
Date: Fri, 2 Oct 2026 08:13:16 -0400
Subject: [PATCH 3/3] accumulator: serialize the 1PP correction with receives

fanout() sends each cycling-unit pulse to all units concurrently. At
1PP time an accumulator whose receive program has the correct switch
set (cc C) increments its units digit in doonepp() (the accunit
goroutine), while a subtracting accumulator's 1' pulse for the same
unit arrives through accunit2() -> accrecv(), which increments the
same digit in another goroutine. Both are unsynchronized
read-modify-writes of u.val[0], so now and then one increment is lost.

trajdemo.e then punches cards whose last field is a few units low from
some card on (anywhere from card 2 to card 18, about 1 run in 3 on a
loaded machine). go build -race reports accrecv (accumulator.go:388)
against doonepp (accumulator.go:561). A per-accumulator mutex around
both updates makes the output identical run to run (12 of 12 runs,
including 8 at once).
---
 src/accumulator.go | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/accumulator.go b/src/accumulator.go
index cc9917b..33bcb97 100644
--- a/src/accumulator.go
+++ b/src/accumulator.go
@@ -3,6 +3,7 @@ package main
 import (
 	"fmt"
 	"strconv"
+	"sync"
 )
 
 /*
@@ -69,6 +70,7 @@ type accumulator struct {
 	whichrp             bool
 	change              chan int
 	lbuddy, rbuddy      int
+	mu                  sync.Mutex // val, decff, sign: accrecv vs the 1PP correction
 }
 
 var units [20]accumulator
@@ -383,6 +385,8 @@ func st2(unit int) int {
 
 func accrecv(unit, dat int) {
 	u := &units[unit]
+	u.mu.Lock()
+	defer u.mu.Unlock()
 	for i := 0; i < 10; i++ {
 		if dat&1 == 1 {
 			u.val[i]++
@@ -558,11 +562,13 @@ func doonepp(u *accumulator, unit int, resp chan int) {
 		 * Connection of PX-5-109 pins 14, 15
 		 */
 		if u.rbuddy == unit {
+			u.mu.Lock()
 			u.val[0]++
 			if u.val[0] > 9 {
 				u.val[0] = 0
 				u.decff[0] = true
 			}
+			u.mu.Unlock()
 		}
 	}
 	if curprog&(stAS|stS) != 0 && u.S != nil {
-- 
